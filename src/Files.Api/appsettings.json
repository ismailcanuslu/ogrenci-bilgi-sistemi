{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FilesDatabase": "Server=localhost;Database=obs_files;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Files": {
    "Storage": {
      "Provider": "S3",
      "BasePath": "uploads",
      "S3": {
        "ServiceUrl": "http://localhost:9000",
        "BucketName": "obs-files",
        "AccessKey": "minioadmin",
        "SecretKey": "minioadmin",
        "Region": "eu-central-1",
        "ForcePathStyle": true
      }
    },
    "Validation": {
      "MaxFileSizeInBytes": 52428800
    },
    "Security": {
      "EnforceAuthorization": false,
      "AllowAnonymousRead": false,
      "AdminRoleName": "Admin"
    }
  }
}
