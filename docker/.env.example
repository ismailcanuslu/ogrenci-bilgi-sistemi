# ==========================================
# Genel Proje Ayarları
# ==========================================
COMPOSE_PROJECT_NAME=obs-platform
ASPNETCORE_ENVIRONMENT=Development

# ==========================================
# Veritabanı Ayarları (SQL Server & PostgreSQL)
# ==========================================
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=YourStrong@Password123!

POSTGRES_USER=obs_admin
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=obs_db
POSTGRES_PORT=5432

# ==========================================
# Redis (Memcache/Cache) Ayarları
# ==========================================
REDIS_PORT=6379

# ==========================================
# MinIO (S3 Uyumlu Object Storage)
# ==========================================
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=obs-files
MINIO_REGION=eu-central-1

# ==========================================
# Mailpit (SMTP Test Sunucusu)
# ==========================================
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Example University"

# ==========================================
# Uygulama Portları
# ==========================================
API_PORT=5050
SECURITY_API_PORT=5001
FILES_API_PORT=5002
NOTIFICATIONS_API_PORT=5003
TRANSLATIONS_API_PORT=5004
AUDITING_API_PORT=5005
MESSAGING_API_PORT=5006
SCHEDULING_API_PORT=5007
WEBHOOKS_API_PORT=5008
IMPORTEXPORT_API_PORT=5009
SPA_PORT=3000

# ==========================================
# OpenTelemetry & İzlenebilirlik Ayarları
# ==========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://obs-jaeger:4317

# ==========================================
# Security (JWT & FIDO2) Ayarları
# ==========================================
JWT_ISSUER=obs-platform
JWT_AUDIENCE=obs-api
JWT_LIFETIME_MINUTES=60
JWT_PUBLIC_KEY=development-public-key
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_RSA_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

FIDO2_RPID=localhost
FIDO2_RPNAME="Example University OBS"
FIDO2_ORIGIN=http://localhost:5000

# ==========================================
# Files Modülü Ayarları
# ==========================================
FILES_STORAGE_PROVIDER=S3
FILES_STORAGE_BASE_PATH=uploads
FILES_MAX_SIZE_BYTES=52428800
FILES_ENFORCE_AUTH=false

# ==========================================
# Notifications (E-Posta Branding & SMS)
# ==========================================
NOTIFICATIONS_PROVIDER=Smtp
BRANDING_COMPANY_NAME="Example University"
BRANDING_LOGO_URL=https://example.com/assets/logo.png
BRANDING_SUPPORT_URL=https://support.example.com
BRANDING_SUPPORT_EMAIL=support@example.com
BRANDING_COMPANY_ADDRESS="Example University Rectorate, Istanbul"
BRANDING_PRIMARY_COLOR=#6166BE
BRANDING_ACCENT_COLOR=#F0F0F9
BRANDING_DEFAULT_THEME=ModernCard

SMS_PROVIDER=Console
SMS_SENDER_HEADER=OBSPLATFORM
SMS_ENDPOINT_URL=https://api.sms-provider.example.com/v1/send
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
