{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NotificationsDatabase": "Server=localhost;Database=obs_notifications;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Notifications": {
    "Provider": "Smtp",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "EnableSsl": false,
      "FromEmail": "noreply@obs-platform.local",
      "FromName": "OBS Platform"
    },
    "Branding": {
      "CompanyName": "OBS Platform",
      "LogoUrl": "https://example.com/assets/logo.png",
      "SupportUrl": "https://support.example.com",
      "SupportEmail": "support@example.com",
      "CompanyAddress": "Example University Campus, Istanbul",
      "PrimaryColor": "#6166BE",
      "AccentColor": "#F0F0F9",
      "DefaultTheme": "ModernCard"
    },
    "Sms": {
      "Provider": "Console",
      "SenderHeader": "OBSPLATFORM",
      "EndpointUrl": "https://api.sms-provider.example.com/v1/send",
      "ApiKey": "example-api-key"
    }
  }
}
