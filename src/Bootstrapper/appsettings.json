{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SecurityDatabase": "Server=localhost;Database=obs_security;Trusted_Connection=True;TrustServerCertificate=True;",
    "AcademicDatabase": "Server=localhost;Database=obs_academic;Trusted_Connection=True;TrustServerCertificate=True;",
    "FilesDatabase": "Server=localhost;Database=obs_files;Trusted_Connection=True;TrustServerCertificate=True;",
    "NotificationsDatabase": "Server=localhost;Database=obs_notifications;Trusted_Connection=True;TrustServerCertificate=True;",
    "AuditingDatabase": "Server=localhost;Database=obs_auditing;Trusted_Connection=True;TrustServerCertificate=True;",
    "MessagingDatabase": "Server=localhost;Database=obs_messaging;Trusted_Connection=True;TrustServerCertificate=True;",
    "SchedulingDatabase": "Server=localhost;Database=obs_scheduling;Trusted_Connection=True;TrustServerCertificate=True;",
    "WebhooksDatabase": "Server=localhost;Database=obs_webhooks;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "obs-platform",
    "Audience": "obs-api",
    "AccessTokenLifetimeMinutes": 60,
    "PrivateKey": "",
    "PublicKey": "development-public-key"
  },
  "Authorization": {
    "Seed": {
      "BootstrapSystemAdministratorEmail": ""
    }
  },
  "Fido2": {
    "Rpid": "localhost",
    "RpName": "OBS Platform",
    "Origin": "https://localhost:5001"
  },
  "Files": {
    "Storage": {
      "Provider": "S3",
      "BasePath": "uploads",
      "S3": {
        "ServiceUrl": "http://localhost:9000",
        "BucketName": "obs-files",
        "AccessKey": "minioadmin",
        "SecretKey": "minioadmin",
        "Region": "eu-central-1",
        "ForcePathStyle": true
      }
    },
    "Validation": {
      "MaxFileSizeInBytes": 52428800
    },
    "Security": {
      "EnforceAuthorization": false,
      "AllowAnonymousRead": false,
      "AdminRoleName": "Admin"
    }
  },
  "Notifications": {
    "Provider": "Smtp",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "EnableSsl": false,
      "FromEmail": "noreply@obs-platform.local",
      "FromName": "OBS Platform"
    },
    "Branding": {
      "CompanyName": "OBS Platform",
      "LogoUrl": "https://example.com/assets/logo.png",
      "SupportUrl": "https://support.example.com",
      "SupportEmail": "support@example.com",
      "CompanyAddress": "Example University Campus, Istanbul",
      "PrimaryColor": "#6166BE",
      "AccentColor": "#F0F0F9",
      "DefaultTheme": "ModernCard"
    },
    "Sms": {
      "Provider": "Console",
      "SenderHeader": "OBSPLATFORM",
      "EndpointUrl": "https://api.sms-provider.example.com/v1/send",
      "ApiKey": "example-api-key"
    }
  }
}
